{
  "manifest_version": 3,
  "name": "IDM Linux Bridge",
  "version": "2.1.0",
  "description": "Integração do Internet Download Manager com Linux via Wine",

  "permissions": [
    "webRequest",
    "downloads",
    "tabs",
    "cookies",
    "storage",
    "notifications",
    "contextMenus",
    "declarativeNetRequest",
    "scripting",
    "alarms"
  ],

  "host_permissions": [
    "\u003Call_urls>",
    "http://127.0.0.1:6969/*"
  ],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["src/parser_m3u8.js", "src/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*/*" ],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],

  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*.svg", "icons/*.png", "src/interceptor.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "idm-linux-bridge@local",
      "strict_min_version": "109.0"
    }
  }
}
